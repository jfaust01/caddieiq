// CaddieIQ — Production database schema
// Sprint 3.1: Prisma foundation (User, Profile, Subscription, Tour, Season).
// Provider: PostgreSQL (Neon-compatible).
//
// Conventions:
//   - Primary keys: `String @id @default(cuid())` (never auto-increment integers).
//   - Audit fields: every model has `createdAt` / `updatedAt`.
//   - Soft deletes (`deletedAt`) are only added where they make sense.
//   - Table names are mapped to snake_case plurals via `@@map`.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SubscriptionTier {
  FREE
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIAL
}

enum UserRole {
  USER
  ADMIN
}

enum TourType {
  PGA
  DP_WORLD
  LIV
  KORN_FERRY
  LPGA
}

enum Handedness {
  RIGHT
  LEFT
  UNKNOWN
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
  INJURED
  RETIRED
}

enum RankingSystem {
  OWGR
  DATAGOLF
  CADDIEIQ
}

enum GrassType {
  BENT
  BERMUDA
  POA
  RYE
  ZOYSIA
  FESCUE
  OTHER
}

enum CourseStyle {
  LINKS
  PARKLAND
  DESERT
  HEATHLAND
  MOUNTAIN
  OTHER
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Application user / account.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  profile       Profile?
  subscriptions Subscription[]

  // `email` is already indexed by the `@unique` constraint above.
  @@map("users")
}

/// One-to-one extension of a User with presentation & preference data.
model Profile {
  id           String    @id @default(cuid())
  userId       String    @unique
  displayName  String?
  timezone     String?
  favoriteTour TourType?
  preferences  Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // `userId` is already indexed by the `@unique` constraint above.
  @@map("profiles")
}

/// Billing subscription for a User. A user may have many over time.
model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  tier               SubscriptionTier   @default(FREE)
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

/// A professional golf tour (PGA, DP World, LIV, etc.).
model Tour {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  type      TourType
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  seasons             Season[]
  playerTourHistories PlayerTourHistory[]

  @@index([type])
  @@map("tours")
}

/// A single competitive season belonging to a Tour.
model Season {
  id        String   @id @default(cuid())
  tourId    String
  year      Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tour                Tour                @relation(fields: [tourId], references: [id], onDelete: Cascade)
  playerTourHistories PlayerTourHistory[]

  // A tour can only have one record per calendar year.
  @@unique([tourId, year])
  @@index([tourId])
  @@index([year])
  @@map("seasons")
}

// ---------------------------------------------------------------------------
// Player Ecosystem (Sprint 3.2)
// ---------------------------------------------------------------------------

/// A professional golfer. Supports soft deletion via `deletedAt`.
model Player {
  id            String       @id @default(cuid())
  firstName     String
  lastName      String
  fullName      String
  slug          String       @unique
  birthDate     DateTime?
  heightCm      Int?
  weightKg      Int?
  turnedProYear Int?
  handedness    Handedness   @default(UNKNOWN)
  status        PlayerStatus @default(ACTIVE)
  headshotUrl   String?
  countryCode   String?
  nationalityId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  // Relations
  nationality  Nationality?        @relation(fields: [nationalityId], references: [id], onDelete: SetNull)
  tourHistory  PlayerTourHistory[]
  rankings     PlayerRanking[]

  @@index([slug])
  @@index([lastName])
  @@index([countryCode])
  @@index([nationalityId])
  @@map("players")
}

/// A country / nationality reference used by players.
model Nationality {
  id        String   @id @default(cuid())
  name      String
  iso2      String   @unique
  iso3      String   @unique
  flagEmoji String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  players Player[]

  @@map("nationalities")
}

/// Tracks a player's membership on a tour over time (allows moving between tours).
model PlayerTourHistory {
  id        String    @id @default(cuid())
  playerId  String
  tourId    String
  seasonId  String?
  joinedAt  DateTime
  leftAt    DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  player Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tour   Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@index([playerId])
  @@index([tourId])
  @@index([seasonId])
  @@map("player_tour_histories")
}

/// A player's rank within a given ranking system at a point in time.
model PlayerRanking {
  id            String        @id @default(cuid())
  playerId      String
  rankingSystem RankingSystem
  rank          Int
  points        Float?
  effectiveDate DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([rankingSystem])
  @@index([effectiveDate])
  @@map("player_rankings")
}

// ---------------------------------------------------------------------------
// Course Engine (Sprint 3.3)
// ---------------------------------------------------------------------------

/// A professional golf course. Supports soft deletion via `deletedAt`.
model Course {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  city            String?
  stateProvince   String?
  country         String?
  latitude        Float?
  longitude       Float?
  par             Int?
  yardage         Int?
  altitudeFt      Int?
  establishedYear Int?
  website         String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  characteristic CourseCharacteristic?

  @@index([slug])
  @@index([country])
  @@map("courses")
}

/// Analytics describing how a course plays. One record per course.
model CourseCharacteristic {
  id                  String       @id @default(cuid())
  courseId            String       @unique
  style               CourseStyle?
  fairwayGrass        GrassType?
  greenGrass          GrassType?
  roughGrass          GrassType?
  averageGreenSize    Float?
  greenSpeed          Float?
  fairwayWidth        Float?
  roughLength         Float?
  treeLined           Boolean?
  waterHazards        Int?
  windExposure        Float?
  elevationChange     Float?
  walkingDifficulty   Float?
  drivingImportance   Float?
  approachImportance  Float?
  shortGameImportance Float?
  puttingImportance   Float?
  scramblingDifficulty Float?
  birdieRate          Float?
  bogeyRate           Float?
  varianceRating      Float?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([style])
  @@map("course_characteristics")
}
