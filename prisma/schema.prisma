// CaddieIQ — Production database schema
// Sprint 3.1: Prisma foundation (User, Profile, Subscription, Tour, Season).
// Provider: PostgreSQL (Neon-compatible).
//
// Conventions:
//   - Primary keys: `String @id @default(cuid())` (never auto-increment integers).
//   - Audit fields: every model has `createdAt` / `updatedAt`.
//   - Soft deletes (`deletedAt`) are only added where they make sense.
//   - Table names are mapped to snake_case plurals via `@@map`.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SubscriptionTier {
  FREE
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIAL
}

enum UserRole {
  USER
  ADMIN
}

enum TourType {
  PGA
  DP_WORLD
  LIV
  KORN_FERRY
  LPGA
}

enum Handedness {
  RIGHT
  LEFT
  UNKNOWN
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
  INJURED
  RETIRED
}

/// Outcome classification for a recorded import run. `SUCCESS` = every record
/// that could be persisted was, with no failures; `PARTIAL` = the run completed
/// but some records failed (or the feed is knowingly degraded, e.g. a scrambled
/// trial-tier value family); `FAILURE` = the run threw before completing.
enum ImportRunStatus {
  SUCCESS
  PARTIAL
  FAILURE
}

enum GrassType {
  BENT
  BERMUDA
  POA
  RYE
  ZOYSIA
  FESCUE
  OTHER
}

enum CourseStyle {
  LINKS
  PARKLAND
  DESERT
  HEATHLAND
  MOUNTAIN
  OTHER
}

enum TournamentStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELED
}

enum MappingVerificationStatus {
  /// Awaiting manual admin review
  PENDING_REVIEW
  /// Verified and eligible for import
  VERIFIED
  /// Rejected and should not be imported
  REJECTED
}

enum TournamentFormat {
  STROKE_PLAY
  MATCH_PLAY
  TEAM
  STABLEFORD
}

enum TournamentFieldStatus {
  CONFIRMED
  ALTERNATE
  WITHDRAWN
  DISQUALIFIED
  CUT
  FINISHED
}

enum RoundStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

// ---------------------------------------------------------------------------
// Historical Data Enums (Phase 17.3A)
// ---------------------------------------------------------------------------

enum EntityType {
  PLAYER
  TOURNAMENT
  COURSE
}

enum MappingStatus {
  VERIFIED
  PENDING
  DISPUTED
  REJECTED
}

enum DataQualityStatus {
  VERIFIED
  ESTIMATED
  PARTIAL
  ERROR
}

enum AuditEventType {
  FEATURE_ADDED
  FEATURE_UPDATED
  SNAPSHOT_SEALED
  LOCK_DATETIME_SET
  FIELD_ENTRY_CONFIRMED
  FIELD_WITHDRAWAL
}

enum QualityReportStatus {
  EXCELLENT
  GOOD
  ACCEPTABLE
  DEGRADED
  FAILED
}

enum RankingSystem {
  WORLD_GOLF_RANKING
  FEDEX_CUP
  OTHER
}

enum ImportJobType {
  TOURNAMENT_EDITION
  TOURNAMENT_FIELD
  PLAYER_FEATURES
  RANKINGS
  SALARIES_ODDS
  OUTCOMES
}

enum ImportJobStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum AlternateStatus {
  PRIMARY
  ALTERNATE
  ALTERNATE_CALLED
}

enum CutStatus {
  MADE
  MISSED
  UNKNOWN
}

enum WithdrawalStatus {
  UNKNOWN
  WITHDRAWN_BEFORE_START
  WITHDRAWN_AFTER_START
  NOT_WITHDRAWN

  @@map("withdrawal_status")
}

enum DatasetType {
  TOURNAMENT_EDITIONS
  COURSE_EDITIONS
  PLAYER_VERSIONS
  RANKINGS
  STATISTICS
  STROKES_GAINED
  DRAFT_KINGS_SALARIES
  BETTING_MARKETS
  WEATHER
  OWNERSHIP
  TOURNAMENT_OUTCOMES
  ENGINEERED_FEATURES
  SNAPSHOTS

  @@map("dataset_type")
}

enum ProviderHealthStatus {
  HEALTHY
  DEGRADED
  UNAVAILABLE
  MAINTENANCE

  @@map("provider_health_status")
}

enum FeatureCategory {
  SKILL_METRICS
  FORM_METRICS
  COURSE_HISTORY
  COURSE_FIT
  RANKINGS
  OWNERSHIP
  PLAYER_ATTRIBUTES
  DERIVED
  COMPOSITE

  @@map("feature_category")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Application user / account.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  profile       Profile?
  subscriptions Subscription[]
  sessions      Session[]
  accounts      Account[]

  // `email` is already indexed by the `@unique` constraint above.
  @@map("users")
}

/// One-to-one extension of a User with presentation & preference data.
model Profile {
  id           String    @id @default(cuid())
  userId       String    @unique
  displayName  String?
  timezone     String?
  favoriteTour TourType?
  preferences  Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // `userId` is already indexed by the `@unique` constraint above.
  @@map("profiles")
}

/// Billing subscription for a User. A user may have many over time.
model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  tier               SubscriptionTier   @default(FREE)
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Better Auth (Sprint 4.1)
// These models are required by Better Auth's Prisma adapter. Field names use
// Better Auth's expected camelCase; tables are mapped to snake_case plurals.
// ---------------------------------------------------------------------------

/// An authenticated session. Managed entirely by Better Auth.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A credential/provider account for a user. For email+password auth the
/// hashed password lives here. Managed entirely by Better Auth.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

/// Short-lived verification tokens (e.g. for future email verification).
/// Managed entirely by Better Auth.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// A professional golf tour (PGA, DP World, LIV, etc.).
model Tour {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  type      TourType
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  seasons             Season[]
  playerTourHistories PlayerTourHistory[]
  tournaments         Tournament[]

  @@index([type])
  @@map("tours")
}

/// A single competitive season belonging to a Tour.
model Season {
  id        String   @id @default(cuid())
  tourId    String
  year      Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tour                Tour                @relation(fields: [tourId], references: [id], onDelete: Cascade)
  playerTourHistories PlayerTourHistory[]
  tournaments         Tournament[]

  // A tour can only have one record per calendar year.
  @@unique([tourId, year])
  @@index([tourId])
  @@index([year])
  @@map("seasons")
}

// ---------------------------------------------------------------------------
// Player Ecosystem (Sprint 3.2)
// ---------------------------------------------------------------------------

/// A professional golfer. Supports soft deletion via `deletedAt`.
model Player {
  id            String       @id @default(cuid())
  firstName     String
  lastName      String
  fullName      String
  slug          String       @unique
  birthDate     DateTime?
  heightCm      Int?
  weightKg      Int?
  turnedProYear Int?
  handedness    Handedness   @default(UNKNOWN)
  status        PlayerStatus @default(ACTIVE)
  headshotUrl   String?
  countryCode   String?
  nationalityId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  // Relations
  nationality                     Nationality?              @relation(fields: [nationalityId], references: [id], onDelete: SetNull)
  tourHistory                     PlayerTourHistory[]
  tournamentFields                TournamentField[]
  seasonStatistics                PlayerSeasonStatistic[]
  newsArticles                    NewsArticle[]
  bettingOutcomes                 BettingOutcome[]
  fantasyProjections              FantasyProjection[]
  dfsSalaries                     DfsSalary[]
  oddsQuotes                      OddsQuote[]
  intelligence                    PlayerIntelligence?
  playerIntelligenceBuilds        PlayerIntelligenceBuild[]
  activePlayerIntelligenceBuildId String?                   @unique
  activePlayerIntelligenceBuild   PlayerIntelligenceBuild?  @relation(name: "activePlayerIntelligenceBuild", fields: [activePlayerIntelligenceBuildId], references: [id], onDelete: SetNull)

  // Historical data relations (Phase 17.3A)
  historicalPlayerFeatures HistoricalPlayerFeature[]
  historicalSnapshots      HistoricalSnapshot[]
  historicalRankings       HistoricalPlayerRanking[]
  historicalSalaryOdds     HistoricalSalaryOddsSnapshot[]
  historicalOutcomes       HistoricalTournamentOutcome[]
  historicalFeatureSamples HistoricalFeatureSample[]
  matchScores              MatchScore[]

  @@index([slug])
  @@index([lastName])
  @@index([countryCode])
  @@index([nationalityId])
  @@map("players")
}

/// A country / nationality reference used by players.
model Nationality {
  id        String    @id @default(cuid())
  name      String
  iso2      String    @unique
  iso3      String    @unique
  flagEmoji String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  players Player[]

  @@map("nationalities")
}

/// Tracks a player's membership on a tour over time (allows moving between tours).
model PlayerTourHistory {
  id        String    @id @default(cuid())
  playerId  String
  tourId    String
  seasonId  String?
  joinedAt  DateTime
  leftAt    DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  player Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tour   Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@index([playerId])
  @@index([tourId])
  @@index([seasonId])
  @@map("player_tour_histories")
}

// NOTE (data-integrity audit, 2026-07): the former `PlayerRanking` /
// `player_rankings` table was removed. No importer ever wrote it, so it only
// ever held stale seed rows while the authoritative Official World Golf Ranking
// is imported onto `PlayerSeasonStatistic.worldRanking`, and CaddieIQ/model
// ranks are derived on demand by the Ranking Engine (`lib/rankings`, which has
// no repository by design). Keeping a second, unwritten ranking table was pure
// duplication. See docs/DATA_INTEGRITY.md for the full rankings architecture.

/// A player's season-level statistics as reported by the data provider, keyed
/// by `(playerId, season)` so re-imports update in place rather than
/// duplicating. Imported independently of the `Player` record it references.
///
/// IMPORTANT — provider coverage: this model stores ONLY the season fields the
/// current SportsDataIO tier actually returns from `/json/PlayerSeasonStats`:
/// world ranking, events played, and fantasy-points aggregates. Money, FedEx
/// Cup points, wins, top-10s, cuts made, scoring average, driving, GIR,
/// scrambling, sand saves, and strokes-gained are NOT provided at season level
/// by the source, so they are intentionally absent here — CaddieIQ never
/// fabricates unavailable statistics. `worldRanking` is stored verbatim; the
/// upstream tier is known to obfuscate its precision (ties), so downstream
/// consumers must treat it as indicative, not authoritative.
model PlayerSeasonStatistic {
  id       String @id @default(cuid())
  playerId String
  /// Calendar season year (e.g. 2025), as reported by the provider.
  season   Int

  // --- Provided by the source (nullable = not reported for this player) ---
  /// Official World Golf Ranking position for the season.
  worldRanking         Int?
  /// World ranking from the previous week (movement context).
  worldRankingLastWeek Int?
  /// Events played in the season.
  events               Int?
  /// Average fantasy points per event.
  averagePoints        Float?
  /// Total fantasy points across the season.
  totalPoints          Float?
  /// Fantasy points gained (positive contributions).
  pointsGained         Float?
  /// Fantasy points lost (negative contributions).
  pointsLost           Float?

  /// Provider provenance: the source name and its native season-stat id.
  source     String  @default("sportsdataio")
  externalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // One statistics row per player per season.
  @@unique([playerId, season])
  @@index([playerId])
  @@index([season])
  @@index([worldRanking])
  @@map("player_season_statistics")
}

/// A news article from the data provider (SportsDataIO `/json/News`).
///
/// Player association is OPTIONAL: the news feed carries only the provider's
/// native numeric `PlayerID` (no name), which is reconciled to a `Player` at
/// import time via the Players feed (PlayerID → name → deterministic slug).
/// Articles with no resolvable player — general or tournament-wide news — are
/// retained with `playerId` null rather than discarded. Keyed by the provider's
/// native `externalId` (NewsID) so re-imports update in place, never duplicate.
///
/// Every field is stored verbatim from the source. Nothing is fabricated; a
/// null field means the provider did not supply it.
model NewsArticle {
  id          String    @id @default(cuid())
  /// Provider's native news id (SportsDataIO `NewsID`). Unique for idempotency.
  externalId  String    @unique
  title       String
  /// Article body/summary as provided (may be absent).
  content     String?
  url         String?
  /// The publishing outlet as reported by the feed (e.g. "RotoBaller").
  outlet      String?
  author      String?
  /// Comma-separated provider categories (stored verbatim).
  categories  String?
  /// When the provider last updated the article.
  publishedAt DateTime?
  /// Optional player association (null = general/tournament news).
  playerId    String?
  /// Provider provenance (the upstream data source, not the news outlet).
  source      String    @default("sportsdataio")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([playerId])
  @@index([publishedAt])
  @@map("news_articles")
}

// ---------------------------------------------------------------------------
// Course Engine (Sprint 3.3)
// ---------------------------------------------------------------------------

/// A professional golf course. Supports soft deletion via `deletedAt`.
model Course {
  id                    String               @id @default(cuid())
  name                  String
  slug                  String               @unique
  city                  String?
  stateProvince         String?
  country               String?
  latitude              Float?
  longitude             Float?
  // Coordinate provenance (Course Geolocation Engine, Sprint 3.9).
  // `coordinateConfidence` is the source of truth for how far lat/lng may be
  // trusted: VERIFIED = course-precise (Maps + Weather); APPROXIMATE =
  // city-level fallback (Weather only, surfaced as "city-level" in the UI);
  // UNKNOWN = not yet located; ESTIMATED reserved and never written
  // automatically. `coordinateSource` records which provider resolved them
  // (e.g. "osm-nominatim" or "openweather-geocoding"); `coordinatesVerifiedAt`
  // stamps when.
  coordinateConfidence  CoordinateConfidence @default(UNKNOWN)
  coordinateSource      String?
  coordinatesVerifiedAt DateTime?
  par                   Int?
  yardage               Int?
  altitudeFt            Int?
  establishedYear       Int?
  website               String?
  timezone              String?              // IANA timezone (e.g., "America/Mexico_City")
  active                Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?

  // Relations
  characteristic    CourseCharacteristic?
  analytics         CourseAnalytics?
  tournamentCourses TournamentCourse[]
  matchScores       MatchScore[]

  @@index([slug])
  @@index([country])
  // Lets the geolocation engine cheaply find courses still needing coordinates.
  @@index([coordinateConfidence])
  @@map("courses")
}

/// Trust level for a course's stored latitude/longitude, in descending
/// precision. Weather Intelligence consumes VERIFIED and APPROXIMATE (a
/// city-level forecast is adequate for a regional weather model); Maps and
/// other course-precise features consume only VERIFIED.
enum CoordinateConfidence {
  /// The provider resolved the query to an actual golf-course feature (e.g. an
  /// OSM `leisure=golf_course` polygon). Course-precise; safe for maps.
  VERIFIED
  /// A city/locality centroid (from OpenWeather's Geocoding API) used as a
  /// fallback when no course-precise match exists. Accurate to the town, NOT
  /// the course — good enough for regional weather, which is why the weather
  /// engine accepts it, but it MUST be surfaced to users as "city-level".
  APPROXIMATE
  /// Reserved, non-authoritative estimate. Not produced by any pipeline today;
  /// kept for backward compatibility and never persisted automatically.
  ESTIMATED
  /// No coordinate resolved yet. The geolocation engine's work queue.
  UNKNOWN
}

/// Historically-derived analytics for a course, calculated automatically from
/// imported SportsDataIO tournament, round, and hole-level data. Updated every
/// time the Rebuild Course Analytics action runs. Confidence increases as more
/// seasons of data are imported — the engine never fabricates values.
model CourseAnalytics {
  id       String @id @default(cuid())
  courseId String @unique

  /// 1–10 normalized difficulty (higher = harder). Derived from avg score to par,
  /// winning score, cut line, and missed-cut rate across all historical events.
  difficultyRating Float?
  /// 1–10 normalized birdie opportunity (higher = more birdies). From historical birdie %.
  birdieRating     Float?
  /// 1–10 normalized bogey risk (higher = more bogeys). From historical bogey %.
  bogeyRating      Float?
  /// 1–10 normalized scoring variance across the field (higher = more volatile).
  volatilityRating Float?
  /// Estimated DraftKings scoring potential (1–10). Composite of birdies, eagles,
  /// bogeys, and volatility, calibrated to DK point values.
  dfsScoringRating Float?

  /// Average winning score (total strokes) across all historical tournaments.
  averageWinningScore Float?
  /// Average cut line score across all historical tournaments.
  averageCutScore     Float?
  /// Average score to par of the full field at completion.
  averageScoreToPar   Float?

  /// Par-3 difficulty rating (1–10). Null until hole-level data is available.
  par3Difficulty Float?
  /// Par-4 difficulty rating (1–10). Null until hole-level data is available.
  par4Difficulty Float?
  /// Par-5 difficulty rating (1–10). Null until hole-level data is available.
  par5Difficulty Float?

  /// Birdie rate as a decimal fraction (0–1) across all historical rounds.
  historicalBirdieRate Float?
  /// Bogey rate as a decimal fraction (0–1) across all historical rounds.
  historicalBogeyRate  Float?
  /// Eagle rate as a decimal fraction (0–1) across all historical rounds.
  historicalEagleRate  Float?

  /// Machine-derived classification (e.g. "Birdie Fest", "Major Championship Test").
  courseArchetype String?

  /// 0–1 confidence score. Increases with sample size. Never fabricated.
  confidenceScore Float?
  /// Number of tournament rounds used in this calculation.
  sampleSize      Int    @default(0)

  lastCalculated DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_analytics")
}

/// Analytics describing how a course plays. One record per course.
model CourseCharacteristic {
  id                   String       @id @default(cuid())
  courseId             String       @unique
  style                CourseStyle?
  fairwayGrass         GrassType?
  greenGrass           GrassType?
  roughGrass           GrassType?
  averageGreenSize     Float?
  greenSpeed           Float?
  fairwayWidth         Float?
  roughLength          Float?
  treeLined            Boolean?
  waterHazards         Int?
  windExposure         Float?
  elevationChange      Float?
  walkingDifficulty    Float?
  drivingImportance    Float?
  approachImportance   Float?
  shortGameImportance  Float?
  puttingImportance    Float?
  scramblingDifficulty Float?
  birdieRate           Float?
  bogeyRate            Float?
  varianceRating       Float?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([style])
  @@map("course_characteristics")
}

// ---------------------------------------------------------------------------
// Tournament Engine (Sprint 3.4)
// ---------------------------------------------------------------------------

/// A professional golf tournament. Supports historical, active, and future
/// events across multiple tours and seasons. Soft-deletable via `deletedAt`.
model Tournament {
  id                 String           @id @default(cuid())
  tourId             String
  seasonId           String?
  name               String
  officialName       String?
  slug               String           @unique
  status             TournamentStatus @default(SCHEDULED)
  format             TournamentFormat @default(STROKE_PLAY)
  startDate          DateTime?
  endDate            DateTime?
  purse              Decimal?
  fedExPoints        Int?
  worldRankingPoints Int?
  cutAfterRounds     Int?
  cutLine            Int?
  numberOfRounds     Int              @default(4)
  active             Boolean          @default(true)
  /// SportsDataIO tournament ID for leaderboard/results fetching
  externalId         String?

  // Historical data fields (Phase 17.3A)
  lockDatetime            DateTime?         @map("lock_datetime")
  lockDatetimeSetAt       DateTime?         @map("lock_datetime_set_at")
  editionSequence         Int?              @map("edition_sequence")
  tournamentSeriesId      String?           @map("tournament_series_id")
  providerEditionId       String?   @unique @map("provider_edition_id")
  lockDatetimeIsImmutable Boolean   @default(false) @map("lock_datetime_is_immutable")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tour               Tour                @relation(fields: [tourId], references: [id], onDelete: Cascade)
  season             Season?             @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  tournamentCourses  TournamentCourse[]
  field              TournamentField[]
  rounds             Round[]
  bettingEvents      BettingEvent[]
  fantasyProjections FantasyProjection[]
  dfsSalaries        DfsSalary[]
  weatherSnapshot    WeatherSnapshot?
  weatherImportLogs  WeatherImportLog[]
  oddsEvents         OddsEvent[]

  // Historical data relations (Phase 17.3A)
  historicalSnapshots  HistoricalSnapshot[]
  historicalSalaryOdds HistoricalSalaryOddsSnapshot[]
  historicalOutcomes   HistoricalTournamentOutcome[]
  historicalFeatureSamples HistoricalFeatureSample[]
  matchScores          MatchScore[]

  @@index([slug])
  @@index([tourId])
  @@index([seasonId])
  @@index([status])
  @@index([lockDatetime])
  @@index([providerEditionId])
  @@map("tournaments")
}

/// Links a tournament to the course(s) it is played on for a given year,
/// allowing venues to rotate across seasons.
model TournamentCourse {
  id           String   @id @default(cuid())
  tournamentId String
  courseId     String
  year         Int
  hostCourse   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // A tournament uses one venue record per calendar year.
  @@unique([tournamentId, year])
  @@index([year])
  @@index([courseId])
  @@map("tournament_courses")
}

// ---------------------------------------------------------------------------
// Tournament Field (Sprint 3.5)
// ---------------------------------------------------------------------------

/// A player's participation in a tournament. This is the anchor record that
/// future rounds, statistics, betting lines, DFS salaries, ownership
/// projections, and AI explanations will all reference.
model TournamentField {
  id            String                @id @default(cuid())
  tournamentId  String
  playerId      String
  playerNumber  Int?
  status        TournamentFieldStatus @default(CONFIRMED)
  isAlternate   Boolean               @default(false)
  qualified     Boolean               @default(true)
  teeTime       DateTime?
  startingHole  Int?
  withdrawn     Boolean               @default(false)
  disqualified  Boolean               @default(false)
  cutMade       Boolean?
  finalPosition Int?
  earnings      Decimal?

  // Historical data fields (Phase 17.3A)
  entryConfirmedAt         DateTime?        @map("entry_confirmed_at")
  withdrawalTimestamp      DateTime?        @map("withdrawal_timestamp")
  withdrawalKnownTimestamp DateTime?        @map("withdrawal_known_timestamp")
  entryStatusChangedAt     DateTime         @default(now()) @map("entry_status_changed_at")
  sourceEffectiveTimestamp DateTime?        @map("source_effective_timestamp")
  alternateStatus          AlternateStatus? @map("alternate_status")
  alternateCallTimestamp   DateTime?        @map("alternate_call_timestamp")
  sourceProvider           String           @default("sportsdataio") @map("source_provider")
  sourceRecordId           String?          @map("source_record_id")
  retrievedTimestamp       DateTime?        @map("retrieved_timestamp")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player       Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerRounds PlayerRound[]

  // A player can only appear once in a given tournament.
  @@unique([tournamentId, playerId])
  @@index([tournamentId])
  @@index([playerId])
  @@index([status])
  @@index([teeTime])
  @@index([sourceProvider, sourceRecordId])
  @@index([entryConfirmedAt, withdrawalTimestamp])
  @@map("tournament_fields")
}

// ---------------------------------------------------------------------------
// Round (Sprint 3.6)
// ---------------------------------------------------------------------------

/// One scheduled round of a tournament. Players are not attached yet; that
/// arrives in a later sprint (PlayerRound).
model Round {
  id             String      @id @default(cuid())
  tournamentId   String
  roundNumber    Int
  scheduledDate  DateTime?
  status         RoundStatus @default(SCHEDULED)
  courseSetup    Json?
  weatherSummary String?
  completed      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerRounds PlayerRound[]

  // A tournament can only have one record per round number.
  @@unique([tournamentId, roundNumber])
  @@index([tournamentId])
  @@index([roundNumber])
  @@index([status])
  @@map("rounds")
}

// ---------------------------------------------------------------------------
// Player Round (Sprint 3.7)
// ---------------------------------------------------------------------------

/// One player's performance during one tournament round. This is the anchor
/// record that every future statistic, fantasy score, betting result, AI
/// explanation, and model score will reference.
model PlayerRound {
  id                String    @id @default(cuid())
  roundId           String
  tournamentFieldId String
  score             Int?
  toPar             Int?
  position          Int?
  madeCut           Boolean?
  withdrawn         Boolean   @default(false)
  disqualified      Boolean   @default(false)
  teeTime           DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  round           Round           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  tournamentField TournamentField @relation(fields: [tournamentFieldId], references: [id], onDelete: Cascade)
  statistic       RoundStatistic?

  // A player has exactly one record per round.
  @@unique([roundId, tournamentFieldId])
  @@index([roundId])
  @@index([tournamentFieldId])
  @@index([position])
  @@map("player_rounds")
}

// ---------------------------------------------------------------------------
// Round Statistic (Sprint 3.8)
// ---------------------------------------------------------------------------

/// RAW statistics imported from external providers for a single player round.
/// These values are stored exactly as ingested and must never contain
/// calculated/derived analytics; derived metrics live in a separate model.
model RoundStatistic {
  id                   String   @id @default(cuid())
  playerRoundId        String
  drivingDistance      Float?
  drivingAccuracy      Float?
  fairwaysHit          Int?
  fairwaysPossible     Int?
  greensInRegulation   Int?
  greensPossible       Int?
  putts                Int?
  birdies              Int?
  eagles               Int?
  pars                 Int?
  bogeys               Int?
  doubleBogeys         Int?
  scramblingPercentage Float?
  sandSavePercentage   Float?
  proximityToHole      Float?
  sgOffTheTee          Float?
  sgApproach           Float?
  sgAroundGreen        Float?
  sgPutting            Float?
  sgTotal              Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  playerRound PlayerRound @relation(fields: [playerRoundId], references: [id], onDelete: Cascade)

  // Exactly one statistic record per player round.
  @@unique([playerRoundId])
  @@index([playerRoundId])
  @@map("round_statistics")
}

// ---------------------------------------------------------------------------
// Betting & Fantasy
//
// These pipelines are fully built, but on the current SportsDataIO trial tier
// the *values* arrive scrambled (see docs/DATA_CATALOG.md §scrambling). Each
// scramble-prone model therefore carries an `available` flag: when the importer
// detects a sentinel it persists the real STRUCTURE (ids, relationships) with
// `available = false` and null values, so nothing fake is ever surfaced and
// real values flow automatically once a production key is installed. DFS
// salaries are the exception — they are real when an event is slated — so
// `DfsSalary` has no `available` gate.
// ---------------------------------------------------------------------------

/// A bookmaker betting event tied to a tournament (SportsDataIO BettingEvent).
/// Keyed by the provider's `BettingEventID` for idempotent re-imports.
model BettingEvent {
  id           String    @id @default(cuid())
  /// Provider's native BettingEventID.
  externalId   String    @unique
  /// Resolved CaddieIQ tournament (via slug), or null when unresolved.
  tournamentId String?
  name         String?
  startDate    DateTime?
  source       String    @default("sportsdataio")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tournament Tournament?     @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  markets    BettingMarket[]

  @@index([tournamentId])
  @@map("betting_events")
}

/// A market within a betting event (e.g. "Tournament Winner"). `available` is
/// false when the provider scrambled the market descriptor, in which case
/// `betType` is null and its outcomes carry no real payouts.
model BettingMarket {
  id             String   @id @default(cuid())
  /// Provider's native BettingMarketID.
  externalId     String   @unique
  bettingEventId String
  betType        String?
  name           String?
  /// True only when the market descriptor was NOT scrambled.
  available      Boolean  @default(false)
  source         String   @default("sportsdataio")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event    BettingEvent     @relation(fields: [bettingEventId], references: [id], onDelete: Cascade)
  outcomes BettingOutcome[]

  @@index([bettingEventId])
  @@map("betting_markets")
}

/// A single selection within a market (typically a player to win). Payout
/// fields are null and `available` is false when the value was scrambled.
model BettingOutcome {
  id              String   @id @default(cuid())
  /// Provider's native BettingOutcomeID.
  externalId      String   @unique
  bettingMarketId String
  /// Resolved CaddieIQ player (via slug), or null when unresolved / non-player.
  playerId        String?
  label           String?
  /// American odds (e.g. +500); null when scrambled.
  payoutAmerican  Int?
  /// Decimal odds; null when scrambled.
  payoutDecimal   Decimal?
  /// True only when the payout was NOT scrambled.
  available       Boolean  @default(false)
  source          String   @default("sportsdataio")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  market BettingMarket @relation(fields: [bettingMarketId], references: [id], onDelete: Cascade)
  player Player?       @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([bettingMarketId])
  @@index([playerId])
  @@map("betting_outcomes")
}

/// Per-tournament fantasy projection for a player. `available` is false when the
/// projected points were scrambled/implausible on the trial tier, in which case
/// the point fields are null. Keyed by a composite tournament+player external id.
model FantasyProjection {
  id                      String   @id @default(cuid())
  /// Composite `tournamentExternalId:playerExternalId` idempotency key.
  externalId              String   @unique
  tournamentId            String?
  playerId                String?
  /// Projected DraftKings fantasy points; null when scrambled.
  fantasyPointsDraftKings Decimal?
  /// Projected FanDuel fantasy points; null when scrambled.
  fantasyPointsFanDuel    Decimal?
  /// True only when at least one projection value was NOT scrambled.
  available               Boolean  @default(false)
  source                  String   @default("sportsdataio")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  player     Player?     @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@index([playerId])
  @@map("fantasy_projections")
}

/// A DFS operator salary for a player on a slate. Salaries are REAL whenever an
/// event is slated (upcoming/recent), so there is no scramble gate here — an
/// absent salary simply means the provider did not supply one. Keyed by a
/// composite slate+operator-player external id.
model DfsSalary {
  id                 String   @id @default(cuid())
  /// Composite `slateId:operatorPlayerId` idempotency key.
  externalId         String   @unique
  tournamentId       String?
  playerId           String?
  /// DFS operator, e.g. "DraftKings" or "FanDuel".
  operator           String
  slateId            String?
  operatorPlayerName String?
  /// Salary in whole dollars; null when the operator did not price the player.
  salary             Int?
  source             String   @default("sportsdataio")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  player     Player?     @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@index([playerId])
  @@map("dfs_salaries")
}

// ---------------------------------------------------------------------------
// Odds Intelligence Engine (Sprint 8.7)
//
// The Market Signal Family. Sourced from The Odds API (a *real*, multi-book
// odds feed — distinct from the SportsDataIO betting tables above, which are
// single-book and scrambled on the trial tier). The Odds API golf coverage is
// tournament-WINNER outrights across several sportsbooks, which is exactly the
// multi-book breadth consensus requires. Each row is one sportsbook's price for
// one selection; consensus is DERIVED across books by the Odds Intelligence
// engine, never persisted pre-chewed. Verified odds only: a quote is written
// only when the provider returned a real price. Idempotent + freshness-guarded
// (see OddsQuote.lastUpdate) so re-imports never overwrite newer odds with older.
// ---------------------------------------------------------------------------

/// The market a quote belongs to. The Odds API golf currently offers only
/// TOURNAMENT_WINNER; the remaining markets are modeled so the engine can expose
/// them the moment the provider (or a future feed) offers verified prices —
/// they are never fabricated in the interim.
enum OddsMarketType {
  TOURNAMENT_WINNER
  TOP_5
  TOP_10
  TOP_20
  MAKE_CUT
  MISS_CUT
}

/// A betting event pulled from The Odds API and (when resolvable) linked to a
/// CaddieIQ tournament. Keyed by the provider event id for idempotent refresh.
/// `capturedAt` records when this event's book of quotes was last refreshed and
/// drives the freshness component of market confidence.
model OddsEvent {
  id              String    @id @default(cuid())
  /// The Odds API event id (idempotency key).
  providerEventId String    @unique
  /// The Odds API sport key, e.g. "golf_the_open_championship_winner".
  sportKey        String
  sportTitle      String?
  /// Resolved CaddieIQ tournament (matched by name/slug), or null when unmatched.
  tournamentId    String?
  /// Scheduled tee-off per the provider, when supplied.
  commenceTime    DateTime?
  /// Data source; always a real feed. Never fabricated.
  source          String    @default("the-odds-api")
  /// When this event's quotes were last captured from the provider.
  capturedAt      DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  quotes     OddsQuote[]

  @@index([tournamentId])
  @@index([sportKey])
  @@map("odds_events")
}

/// One sportsbook's price for one selection (player) in one market of an event.
/// Consensus (book count, spread, variance, consensus probability) is computed
/// across the sibling quotes for the same (event, market, selection) — this row
/// stores only verified raw facts. Uniqueness on
/// (event, market, bookmaker, selection) makes refresh idempotent; the importer
/// only overwrites a quote when the incoming `lastUpdate` is newer.
model OddsQuote {
  id                 String         @id @default(cuid())
  oddsEventId        String
  market             OddsMarketType
  /// Bookmaker key, e.g. "draftkings".
  bookmakerKey       String
  /// Human-friendly bookmaker label, e.g. "DraftKings".
  bookmakerTitle     String
  /// Raw selection label from the provider (player name).
  selection          String
  /// Deterministic slug derived from the selection, used to resolve to a Player.
  selectionSlug      String
  /// Resolved CaddieIQ player, or null when unmatched / non-player selection.
  playerId           String?
  /// Decimal odds exactly as provided (source of truth).
  decimalOdds        Decimal
  /// American odds derived from the decimal price.
  americanOdds       Int
  /// Raw implied probability (0..1) derived from the decimal price (includes vig).
  impliedProbability Decimal
  /// The provider's `last_update` for this bookmaker's market; the freshness key.
  lastUpdate         DateTime
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  event  OddsEvent @relation(fields: [oddsEventId], references: [id], onDelete: Cascade)
  player Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([oddsEventId, market, bookmakerKey, selectionSlug])
  @@index([oddsEventId])
  @@index([playerId])
  @@index([oddsEventId, market])
  @@map("odds_quotes")
}

// ---------------------------------------------------------------------------
// Weather Intelligence Engine (Sprint 4.x)
// ---------------------------------------------------------------------------

/// A single captured forecast for a tournament venue — the raw, verified facts
/// the Weather Intelligence Engine normalizes into signals. One (latest) snapshot
/// per tournament; re-importing replaces it. `capturedAt` + `forecast*` bounds
/// drive the confidence grade (forecast age, horizon, coverage). Never holds
/// fabricated data: if the provider returns nothing usable, no snapshot is
/// written and the engine reports weather as unavailable.
model WeatherSnapshot {
  id               String    @id @default(cuid())
  tournamentId     String    @unique
  /// Host course this forecast was fetched for (venue coordinates), when linked.
  courseId         String?
  /// Data source, e.g. "openweather". Never a fabricated feed.
  source           String    @default("openweather")
  /// Venue coordinates the forecast was requested for.
  latitude         Float
  longitude        Float
  /// Seconds offset from UTC at the venue — used to bucket periods into local
  /// days and morning/afternoon waves.
  utcOffsetSeconds Int       @default(0)
  /// When this forecast was captured from the provider (drives forecast age).
  capturedAt       DateTime  @default(now())
  /// Earliest / latest forecast validity times covered by this snapshot.
  forecastStart    DateTime?
  forecastEnd      DateTime?
  /// Number of stored forecast periods (coverage signal).
  periodCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tournament Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  periods    WeatherPeriod[]

  @@index([tournamentId])
  @@map("weather_snapshots")
}

/// A single forecast period (a 3-hour provider bucket) within a snapshot. Every
/// signal is nullable: a value is stored only when the provider supplied it, so
/// the normalizer degrades gracefully rather than reading a fabricated zero.
model WeatherPeriod {
  id                String   @id @default(cuid())
  snapshotId        String
  /// Forecast validity time (UTC).
  forecastTime      DateTime
  /// Air temperature, degrees Celsius.
  temperatureC      Float?
  /// Apparent ("feels like") temperature, degrees Celsius.
  feelsLikeC        Float?
  /// Sustained wind speed, metres per second.
  windSpeedMs       Float?
  /// Wind gust, metres per second.
  windGustMs        Float?
  /// Wind origin direction, meteorological degrees (0 = N, 90 = E).
  windDeg           Int?
  /// Probability of precipitation, 0..1.
  precipProbability Float?
  /// Rain volume over the period, millimetres.
  rainMm            Float?
  /// Relative humidity, percent.
  humidity          Int?
  /// Cloud cover, percent.
  cloudCover        Int?
  /// Sea-level pressure, hectopascals.
  pressureHpa       Int?
  /// Visibility, metres.
  visibilityM       Int?
  /// Provider condition code (e.g. OpenWeather 500) and short label.
  conditionCode     Int?
  conditionLabel    String?
  createdAt         DateTime @default(now())

  snapshot WeatherSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([forecastTime])
  @@map("weather_periods")
}

/// Per-tournament weather import history. One row is written for every
/// tournament the importer *considers* on each execution — whether the forecast
/// was stored, skipped (with the machine-readable reason), or failed. This is the
/// granular, per-event audit trail behind the aggregate `ImportRun`, and the
/// source of truth for a tournament's "last successful import" and whether its
/// most recent attempt failed. Nothing here is fabricated; a skip records why.
model WeatherImportLog {
  id               String              @id @default(cuid())
  /// The aggregate run this per-tournament record belongs to, when part of one.
  importRunId      String?
  tournamentId     String
  /// Denormalized names/coordinates captured at import time, so the history
  /// stays readable even if the tournament or course is later renamed/removed.
  tournamentName   String
  courseId         String?
  courseName       String?
  latitude         Float?
  longitude        Float?
  /// Whether the event was inside the provider's forecast window with usable
  /// coordinates at import time — i.e. eligible to be fetched at all.
  forecastEligible Boolean             @default(false)
  /// Compact provider response descriptor (e.g. "200 · 40 periods") or the
  /// error message when the fetch/persist failed. Never a fabricated value.
  providerResponse String?
  /// New snapshot rows created (1 when the tournament had no prior snapshot).
  rowsInserted     Int                 @default(0)
  /// Existing snapshot rows replaced (1 when re-importing over a prior snapshot).
  rowsUpdated      Int                 @default(0)
  /// Forecast periods written in this execution.
  periodsWritten   Int                 @default(0)
  /// Machine/human-readable reason the tournament was skipped, when SKIPPED.
  skippedReason    String?
  /// Wall-clock duration of this tournament's fetch + persist, in milliseconds.
  durationMs       Int                 @default(0)
  result           WeatherImportResult
  createdAt        DateTime            @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([createdAt])
  @@index([result])
  @@map("weather_import_logs")
}

/// Outcome of a single tournament's weather import attempt.
enum WeatherImportResult {
  /// A forecast was fetched and its snapshot atomically stored.
  STORED
  /// Intentionally not fetched/stored — missing venue/coordinates, outside the
  /// forecast window, or provider unavailable. `skippedReason` explains which.
  SKIPPED
  /// The fetch or persistence errored. `providerResponse` carries the message.
  FAILED
}

// ---------------------------------------------------------------------------
// Operations — import run history
// ---------------------------------------------------------------------------

/// One recorded execution of an import pipeline (players, courses, tournaments,
/// fields, statistics, news, betting, fantasy, geolocation, weather, odds, …).
///
/// This is the durable, honest audit trail behind the admin Data Coverage
/// dashboard. Before it existed the dashboard could only INFER "last import"
/// from each table's `max(updatedAt)`, which cannot distinguish a successful
/// run from one that fetched zero rows or threw. Every top-level `runXImport()`
/// records exactly one row here — including failures — so the dashboard can show
/// real status, row-level counts, and the last error per entity.
///
/// Rows are immutable once written (no `updatedAt`): each run is a fact.
model ImportRun {
  id         String          @id @default(cuid())
  /// Upstream provider the run pulled from (e.g. "sportsdataio", "openweather",
  /// "the-odds-api", "nominatim"). Free-form so new feeds need no migration.
  provider   String
  /// Logical entity the run targeted (e.g. "player", "statistics", "weather").
  /// Free-form to cover relation/enrichment pipelines that have no domain enum.
  entity     String
  status     ImportRunStatus
  startedAt  DateTime
  finishedAt DateTime
  durationMs Int
  /// Records the run attempted (as fetched from the provider).
  processed  Int             @default(0)
  /// New rows created.
  inserted   Int             @default(0)
  /// Existing rows updated (idempotent re-run).
  updated    Int             @default(0)
  /// Rows intentionally not persisted (validation rejection, unmatched bridge,
  /// or a knowingly-unavailable/scrambled trial-tier value).
  skipped    Int             @default(0)
  /// Rows that errored during mapping or persistence.
  failed     Int             @default(0)
  /// Advisory (warning-severity) data-quality issues across the batch.
  warnings   Int             @default(0)
  /// Short human-readable summary of the outcome (counts, notes, or the reason
  /// a feed is degraded). Never fabricated — mirrors the pipeline report.
  summary    String?
  /// First/representative error message when the run failed or partially failed.
  error      String?
  createdAt  DateTime        @default(now())

  @@index([entity, startedAt])
  @@index([provider])
  @@index([status])
  @@index([startedAt])
  @@map("import_runs")
}

// ---------------------------------------------------------------------------
// GolfCourse API Models (Sprint 13.0)
// ---------------------------------------------------------------------------

/// Course details from GolfCourse API.
/// Stores rich course information for reuse throughout the application.
model CourseDetails {
  id               String @id @default(cuid())
  /// External course ID from GolfCourse API
  externalCourseId String @unique

  // Basic
  courseName String
  clubName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations (normalized components)
  address           CourseAddress?
  coordinates       CourseCoordinates?
  specifications    CourseSpecifications?
  metadata          CourseMetadata?
  playingConditions PlayingConditions[]
  holes             CourseHole[]
  tees              CourseTee[]
  intelligence      CourseIntelligence?

  @@index([externalCourseId])
  @@index([courseName])
  @@map("course_details")
}

/// Course address information (normalized 1:1).
model CourseAddress {
  id       String @id @default(cuid())
  courseId String @unique

  city       String?
  state      String?
  country    String?
  postalCode String?

  website String?
  phone   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  course CourseDetails @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_addresses")
}

/// Course GPS coordinates (normalized 1:1).
model CourseCoordinates {
  id       String @id @default(cuid())
  courseId String @unique

  latitude  Float?
  longitude Float?
  elevation Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  course CourseDetails @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([latitude, longitude])
  @@map("course_coordinates")
}

/// Course specifications (normalized 1:1) - par, yardage, USGA ratings.
model CourseSpecifications {
  id       String @id @default(cuid())
  courseId String @unique

  par          Int?
  totalYardage Int?
  courseRating Float?
  slopeRating  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  course CourseDetails @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_specifications")
}

/// Course metadata (normalized 1:1) - architect, style, facilities.
model CourseMetadata {
  id       String @id @default(cuid())
  courseId String @unique

  architect   String?
  yearBuilt   Int?
  courseStyle String?

  // Facilities
  drivingRange  Boolean?
  puttingGreen  Boolean?
  shortGameArea Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  course CourseDetails @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_metadata")
}

/// Playing conditions (normalized 1:M) - grass types, green conditions, temporal tracking.
model PlayingConditions {
  id       String @id @default(cuid())
  courseId String

  grassTypeFairway String?
  grassTypeGreen   String?
  greenSize        String?
  greenSpeed       String?

  /// When these conditions were observed (allows historical tracking)
  observedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  course CourseDetails @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([courseId, observedAt])
  @@map("playing_conditions")
}

/// Individual holes for a course.
model CourseHole {
  id         String   @id @default(cuid())
  courseId   String
  holeNumber Int
  par        Int?
  yardage    Int?
  handicap   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Relations
  course      CourseDetails    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teeYardages TeeHoleYardage[]

  @@unique([courseId, holeNumber])
  @@index([courseId])
  @@map("course_holes")
}

/// Tee information for a course (different sets for different players).
model CourseTee {
  id        String   @id @default(cuid())
  courseId  String
  teeName   String
  teeColor  String?
  gender    String?
  yardage   Int?
  rating    Float?
  slope     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  course       CourseDetails    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  holeYardages TeeHoleYardage[]

  @@unique([courseId, teeName])
  @@index([courseId])
  @@map("course_tees")
}

/// Per-hole yardage for each tee (many-to-many through holes).
model TeeHoleYardage {
  id       String @id @default(cuid())
  teeId    String
  holeId   String
  courseId String // Denormalized for query efficiency

  yardage  Int?
  handicap Int? // May vary by tee

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  tee  CourseTee  @relation(fields: [teeId], references: [id], onDelete: Cascade)
  hole CourseHole @relation(fields: [holeId], references: [id], onDelete: Cascade)

  @@unique([teeId, holeId])
  @@index([teeId])
  @@index([holeId])
  @@index([courseId])
  @@map("tee_hole_yardages")
}

/// Tournament to GolfCourse API mapping layer.
/// Stores the persistent relationship between SportsDataIO tournaments and GolfCourse API courses.
/// This mapping becomes the single source of truth for course enrichment and prevents duplicate searches.
model TournamentCourseMapping {
  id                    String  @id @default(cuid())
  /// Reference to tournament (SportsDataIO tournament ID)
  tournamentId          String  @unique
  /// Course ID from SportsDataIO tournament data
  sportsDataIoCourseId  String?
  /// Course ID from GolfCourse API - the authoritative source
  golfCourseApiCourseId Int?

  /// Display names for reference
  tournamentCourseName String?
  golfCourseCourseName String?

  /// Matching metadata
  /// Confidence score 0-100 from the matching algorithm
  matchConfidence    Int?                      @default(0)
  /// Reasons why the confidence score was assigned (e.g., "Exact name match + City/State match")
  confidenceReason   String?
  /// How the match was determined (e.g., "manual", "auto-matched", "search")
  matchedBy          String?                   @default("auto-matched")
  /// Verification status: PENDING_REVIEW → needs manual verification, VERIFIED → ready for import, REJECTED → should not be imported
  verificationStatus MappingVerificationStatus @default(PENDING_REVIEW)
  /// Legacy field for importer compatibility - maps verificationStatus to boolean
  verified           Boolean                   @default(false)
  /// Auto-verified when confidence >= 95%, set by migration or confidence algorithm
  autoVerified       Boolean                   @default(false)
  /// Notes for why mapping was rejected
  rejectionReason    String?

  /// Audit timestamps
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tournamentId])
  @@index([golfCourseApiCourseId])
  @@index([sportsDataIoCourseId])
  @@map("tournament_course_mappings")
}

/// Course Intelligence — persistent calculations of course metrics.
/// Generated by the Course Intelligence Engine and stored for efficient lookups.
/// Read by Tournament pages, AI features, DFS tools, and analytics.
model CourseIntelligence {
  id String @id @default(cuid())

  /// Reference to course
  courseId String @unique

  /// Overall Difficulty Metric (0-100 score, 1-5 stars)
  overallDifficultyScore Int @default(0)
  overallDifficultyStars Int @default(1)

  /// Driving Importance (0-100 score, 1-5 stars)
  drivingImportanceScore Int @default(0)
  drivingImportanceStars Int @default(1)

  /// Approach Shot Importance (0-100 score, 1-5 stars)
  approachImportanceScore Int @default(0)
  approachImportanceStars Int @default(1)

  /// Short Game Importance (0-100 score, 1-5 stars)
  shortGameImportanceScore Int @default(0)
  shortGameImportanceStars Int @default(1)

  /// Putting Importance (0-100 score, 1-5 stars)
  puttingImportanceScore Int @default(0)
  puttingImportanceStars Int @default(1)

  /// Wind Sensitivity (0-100 score, 1-5 stars)
  windSensitivityScore Int @default(0)
  windSensitivityStars Int @default(1)

  /// Penalty Severity (0-100 score, 1-5 stars)
  penaltySeverityScore Int @default(0)
  penaltySeverityStars Int @default(1)

  /// Birdie Potential (0-100 score, 1-5 stars)
  birdiePotentialScore Int @default(0)
  birdiePotentialStars Int @default(1)

  /// Scoring Volatility (0-100 score, 1-5 stars)
  scoringVolatilityScore Int @default(0)
  scoringVolatilityStars Int @default(1)

  /// Additional Difficulty Metrics
  /// Scoring Difficulty - difficulty of scoring well
  scoringDifficultyScore Int @default(0)
  scoringDifficultyStars Int @default(1)

  /// Bogey Risk - likelihood of scoring bogey or worse
  bogeyRiskScore Int @default(0)
  bogeyRiskStars Int @default(1)

  /// Difficulty Variance - hole-to-hole consistency
  varianceScore Int @default(0)
  varianceStars Int @default(1)

  /// Fairway & Short Game Metrics
  /// Fairway Width - estimated fairway width difficulty
  fairwayWidthScore Int @default(0)
  fairwayWidthStars Int @default(1)

  /// Iron Difficulty - approach shot precision difficulty
  ironDifficultyScore Int @default(0)
  ironDifficultyStars Int @default(1)

  /// Putting Difficulty - green complexity
  puttingDifficultyScore Int @default(0)
  puttingDifficultyStars Int @default(1)

  /// Hazard Metrics
  /// Water Hazard Risk
  waterHazardRiskScore Int @default(0)
  waterHazardRiskStars Int @default(1)

  /// Sand Hazard Risk (bunkers)
  sandHazardRiskScore Int @default(0)
  sandHazardRiskStars Int @default(1)

  /// Tree/Vegetation Risk
  treeRiskScore Int @default(0)
  treeRiskStars Int @default(1)

  /// Out of Bounds Risk
  outOfBoundsRiskScore Int @default(0)
  outOfBoundsRiskStars Int @default(1)

  /// Overall Hazard Impact
  hazardImpactScore Int @default(0)
  hazardImpactStars Int @default(1)

  /// Course Characteristics
  /// Elevation Impact
  elevationImpactScore Int @default(0)
  elevationImpactStars Int @default(1)

  /// Weather/Climate Factor
  weatherFactorScore Int @default(0)
  weatherFactorStars Int @default(1)

  /// Overall Playability
  playabilityScore Int @default(0)
  playabilityStars Int @default(1)

  /// Course Uniqueness
  uniquenessScore Int @default(0)
  uniquenessStars Int @default(1)

  /// Data Completeness & Course Tags
  /// How much source data was available (affects confidence levels)
  dataCompleteness Int @default(0)

  /// Course style tags (multiple tags, stored as JSON array)
  courseTags Json @default("[]")

  /// Algorithm version for future recalculation support
  calculationVersion String @default("v1")

  /// Timestamp when calculations were performed
  calculatedAt DateTime @default(now())

  /// Audit timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  course       CourseDetails             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  insights     CourseInsight[]
  explanations CourseMetricExplanation[]

  @@unique([courseId, calculationVersion])
  @@index([courseId])
  @@index([calculatedAt])
  @@map("course_intelligence")
}

/// Course Metric Explanations — transparent factors behind each intelligence metric.
/// Generated deterministically from CourseIntelligence and source course data.
/// Explains why each metric received its score through contributing factors.
model CourseMetricExplanation {
  id String @id @default(cuid())

  /// Reference to course intelligence
  courseIntelligenceId String
  courseIntelligence   CourseIntelligence @relation(fields: [courseIntelligenceId], references: [id], onDelete: Cascade)

  /// Metric identifier (e.g., "drivingImportance", "puttingImportance")
  metric String @db.VarChar(50)

  /// Human-readable title
  title String

  /// Summary explanation of why this metric scored as it did
  summary String @db.Text

  /// Contributing factors formatted as bullet list
  contributingFactors String @db.Text

  /// Algorithm version for future updates
  calculationVersion String @default("v1")

  /// Audit timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseIntelligenceId, metric, calculationVersion])
  @@index([courseIntelligenceId])
  @@index([metric])
  @@map("course_metric_explanations")
}

/// Course Insights — human-readable intelligence derived from metrics.
/// Generated deterministically from CourseIntelligence metrics.
/// Displayed on Tournament Hub, DFS pages, and premium reports.
model CourseInsight {
  id String @id @default(cuid())

  /// Reference to course intelligence
  courseIntelligenceId String
  courseIntelligence   CourseIntelligence @relation(fields: [courseIntelligenceId], references: [id], onDelete: Cascade)

  /// Insight category
  category String @db.VarChar(50)

  /// Insight content
  title   String
  summary String @db.Text

  /// Importance for display ordering (1-5)
  importance Int @default(3)

  /// Icon identifier for UI rendering
  icon String @db.VarChar(50)

  /// Display order within category
  displayOrder Int @default(0)

  /// Audit timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseIntelligenceId, category])
  @@index([courseIntelligenceId])
  @@index([category])
  @@map("course_insights")
}

/// PlayerIntelligence — Aggregated player skill and performance metrics
/// Combines tournament history, fantasy data, and statistical analysis
/// into traceable, normalized features for downstream systems
/// PlayerIntelligenceBuild — Versioned, immutable snapshot of player intelligence
/// Each build is a point-in-time calculation with explicit activation state
/// Enables safe rollback, concurrent rebuild protection, and build history
model PlayerIntelligenceBuild {
  id String @id @default(cuid())

  /// Player reference
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// Build lifecycle status
  /// PENDING: Created, not yet calculated
  /// CALCULATING: Currently computing features
  /// SUCCESS: All features calculated, no failures
  /// PARTIAL: Some features calculated, some failed
  /// FAILED: All calculators failed
  buildStatus String @default("PENDING") @db.VarChar(20)

  /// Activation status (controls whether this build is visible to consumers)
  /// CANDIDATE: Calculated but not yet activated (awaiting policy evaluation)
  /// ACTIVE: Currently active, visible to consumers
  /// SUPERSEDED: Was active, replaced by newer ACTIVE build
  /// REJECTED: Policy evaluation failed, will not be activated
  activationStatus String @default("CANDIDATE") @db.VarChar(20)

  /// Data Completeness (0-100): Percentage of available data used to calculate features
  dataCompleteness Int @default(0)

  /// Feature count at build time
  featureCount          Int @default(0)
  completedFeatureCount Int @default(0)

  /// Activation metadata
  activationReason String?
  rejectionReason  String?

  /// Versioning
  builderVersion          String @db.VarChar(50)
  featureSchemaVersion    String @db.VarChar(50)
  confidencePolicyVersion String @db.VarChar(50)
  activationPolicyVersion String @db.VarChar(50)

  /// Audit timestamps
  calculatedAt DateTime  @default(now())
  activatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Relations
  /// NOTE: PlayerIntelligenceFeature relation will be added in Phase 15.3B
  /// once player_intelligence_features table is created
  /// (features relation commented out - see Phase 15.3B plan)
  asActiveBuild Player? @relation(name: "activePlayerIntelligenceBuild")

  @@unique([playerId, activationStatus])
  @@index([playerId])
  @@index([buildStatus])
  @@index([activationStatus])
  @@index([calculatedAt])
  @@index([activatedAt])
  @@map("player_intelligence_builds")
}

model PlayerIntelligence {
  id String @id @default(cuid())

  /// Player reference
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// Data Completeness (0-100): Percentage of available data used to calculate features
  /// Lower = confidence penalties may apply to some metrics
  dataCompleteness Int @default(0)

  /// Audit timestamps
  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// NOTE: features relation removed - PlayerIntelligenceFeature table
  /// is part of Phase 15.3B and not yet created

  @@unique([playerId])
  @@index([playerId])
  @@index([calculatedAt])
  @@map("player_intelligence")
}

/// PlayerIntelligenceFeature — Immutable feature snapshot
/// Each feature belongs to a specific build (never mutated)
/// Features are only queried via the active build
// NOTE: PlayerIntelligenceFeature model and player_intelligence_features table
// will be created in Phase 15.3B. Commented out for now to avoid validation errors.
// This table is not yet deployed to production databases.
/**
 * model PlayerIntelligenceFeature {
 * id                              String    @id @default(cuid())
 * /// Build reference (immutable per build)
 * playerIntelligenceBuildId       String
 * playerIntelligenceBuild         PlayerIntelligenceBuild @relation(name: "features", fields: [playerIntelligenceBuildId], references: [id], onDelete: Cascade)
 * /// Legacy intelligence reference (for transition period)
 * playerIntelligenceId            String?
 * playerIntelligence              PlayerIntelligence? @relation(fields: [playerIntelligenceId], references: [id], onDelete: SetNull)
 * /// Feature identifier (e.g., "tournament_count", "avg_finish", "driving_distance")
 * /// Provides stable key for querying specific features
 * featureName                     String    @db.VarChar(100)
 * /// Feature category for grouping (e.g., "tournament_stats", "fantasy", "sg_metrics", "calculated")
 * featureCategory                 String    @db.VarChar(50)
 * /// Normalized feature value (number, percentage, or descriptive string)
 * /// Type is context-dependent; category and documentation describe expected format
 * featureValue                    Float?
 * featureValueStr                 String?
 * /// Confidence level (0-100) indicating reliability of this feature
 * /// Lower confidence may indicate sparse data or high variance in source
 * confidence                      Int       @default(100)
 * /// Source of this feature (e.g., "sportsdataio", "calculated", "projected")
 * /// Indicates where the underlying data originated
 * source                          String    @db.VarChar(50) @default("sportsdataio")
 * /// Timestamp when this feature was calculated
 * calculatedAt                    DateTime  @default(now())
 * /// Explanation of how this feature was derived (optional)
 * /// Human-readable notes about methodology, assumptions, or important caveats
 * explanation                     String?
 * /// Audit timestamps
 * createdAt                       DateTime  @default(now())
 * updatedAt                       DateTime  @updatedAt
 * @@unique([playerIntelligenceBuildId, featureName])
 * @@index([playerIntelligenceBuildId])
 * @@index([playerIntelligenceId])
 * @@index([featureName])
 * @@index([featureCategory])
 * @@index([source])
 * @@map("player_intelligence_features")
 * }
 */

// ---------------------------------------------------------------------------
// Matching Engine (Phase 16B.1)
// ---------------------------------------------------------------------------
// Core models for course-player matching engine.
// Supports reproducibility, versioning, auditability, and historical immutability.
// Reference: docs/ARCHITECTURE_MASTER_INDEX.md (Section 8)
// Reference: docs/BUILD_REPRODUCIBILITY.md
// Reference: docs/MODEL_GOVERNANCE.md

/// Release type classification for model versions.
enum MatchVersionReleaseType {
  ALPHA /// Early development, not production-ready
  BETA /// Feature complete, undergoing testing
  RC /// Release candidate, awaiting final approval
  STABLE /// Production-ready
}

/// Algorithm type indicating how the model was trained/calibrated.
enum MatchAlgorithmType {
  HAND_TUNED /// v1.x: Hand-calibrated weights
  GRADIENT_BOOSTED /// v2.x: Optimized with gradient boosting
  ENSEMBLE /// v3.x: Multiple models combined
  DEEP_LEARNING /// v4.x: Neural network based
  REINFORCEMENT_LEARNING /// v5.x: RL-optimized
  LLM_ENHANCED /// v6.x: LLM-augmented reasoning
}

/// Build lifecycle status.
enum MatchScoreBuildStatus {
  DEVELOPMENT /// Under development, not deployable
  CANDIDATE /// Ready for testing, pre-production
  ACTIVE /// Currently in production
  RETIRED /// No longer in use, kept for historical queries
}

/// Audit trail action classification.
enum MatchScoreAction {
  CREATED /// Score first computed
  REQUESTED /// Score retrieved for user access
  EXPLANATION_GENERATED /// Explanation created
  RECREATED_FROM_BUILD /// Score recreated from historical build
  ARCHIVED /// Logical archival (no production access)
}

/// Semantic version of the matching engine. Tracks algorithm type, calibration, and releases.
/// Immutable: version string never changes after creation.
model MatchVersion {
  id              String                  @id @default(cuid())
  /// Semantic version: MAJOR.MINOR.PATCH (e.g., "1.0.0")
  versionString   String                  @unique
  /// Major version (breaking change increment)
  major           Int
  /// Minor version (feature addition increment)
  minor           Int
  /// Patch version (bug fix increment)
  patch           Int
  /// Release type (alpha, beta, rc, stable)
  releaseType     MatchVersionReleaseType @default(STABLE)
  /// Brief description of changes in this version
  description     String?
  /// Algorithm type indicates how this version was trained
  algorithmType   MatchAlgorithmType      @default(HAND_TUNED)
  /// When weights were last calibrated (reproducibility provenance)
  calibrationDate DateTime?
  /// Audit timestamps (immutable)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  // Relations
  builds MatchScoreBuild[]

  // Enforce semantic versioning uniqueness and immutability
  @@unique([major, minor, patch])
  @@index([releaseType])
  @@map("match_versions")
}

/// Build manifest capturing all versioned components for reproducibility.
/// Every score is tied to a build; every build is reproducible from its manifest.
/// Immutable: manifest never changes; only status evolves (dev → candidate → active → retired).
model MatchScoreBuild {
  id                String                @id @default(cuid())
  /// Which model version this build implements
  versionId         String
  /// SHA256 hash of the build manifest (reproducibility proof)
  buildHash         String                @unique
  /// Complete build manifest as JSON (feature versions, score formula, dataset, etc.)
  /// Reference: docs/BUILD_REPRODUCIBILITY.md
  buildManifestJson Json
  /// Current status in the build lifecycle (development → candidate → active → retired)
  status            MatchScoreBuildStatus @default(DEVELOPMENT)
  /// User/system that created this build (audit trail)
  createdBy         String?
  /// When this build was promoted to active (null if not yet active)
  activatedAt       DateTime?
  /// When this build was retired (null if still active)
  retiredAt         DateTime?
  /// Audit timestamps
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Relations
  version             MatchVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  matchScores         MatchScore[]
  recreatedFromScores MatchScore[] @relation("recreatedFromBuild")

  @@index([versionId])
  @@index([buildHash])
  @@index([status])
  @@index([createdAt])
  @@map("match_score_builds")
}

/// Match score: the core prediction record. Immutable except for metadata.
/// Every score tied to: player, course, build (reproducibility), and tournament (context).
/// Historical immutability: no deletion, no value updates, only metadata can change.
model MatchScore {
  id           String  @id @default(cuid())
  /// Player being evaluated (immutable)
  playerId     String
  /// Course being evaluated on (immutable)
  courseId     String
  /// Build that generated this score (immutable, provides reproducibility)
  buildId      String
  /// Tournament context (optional, null if used outside tournament)
  tournamentId String?
  /// Semantic version of the matching engine (immutable)
  version      String

  // --- Five-component score (immutable) ---
  /// Overall combined score (0-100) after all adjustments
  overallScore         Float
  /// Skill fit dimension (0-100): structural player-course alignment
  skillFitScore        Float
  /// Form bonus (-15 to +15): current trajectory vs. baseline
  formBonus            Float
  /// Venue history bonus (-10 to +10): venue-specific performance
  venueHistoryBonus    Float
  /// Confidence multiplier (0.3-1.0): data quality adjustment
  confidenceMultiplier Float
  /// Confidence score (0-100): separate metric indicating data quality
  confidenceScore      Float
  /// Ceiling score: optimistic scenario (what if everything goes right?)
  ceilingScore         Float
  /// Floor score: pessimistic scenario (what if everything goes wrong?)
  floorScore           Float

  // --- Explanation (immutable) ---
  /// Textual explanation (500 chars max), null until generated
  explanation           String?
  /// Detailed component breakdown (JSON), null until generated
  explanationComponents Json?

  // --- Metadata (mutable: only part of the record that can be updated) ---
  /// Additional context (weather, setup, field strength, etc.)
  metadata Json?

  // --- Historical reconstruction support ---
  /// Whether this score was recreated from a historical build (vs. live prediction)
  isHistorical         Boolean @default(false)
  /// If historical, which build was it recreated from
  recreatedFromBuildId String?

  // --- Audit timestamps (immutable) ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  player             Player                 @relation(fields: [playerId], references: [id], onDelete: Cascade)
  course             Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  build              MatchScoreBuild        @relation(fields: [buildId], references: [id], onDelete: Cascade)
  tournament         Tournament?            @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  recreatedFromBuild MatchScoreBuild?       @relation("recreatedFromBuild", fields: [recreatedFromBuildId], references: [id], onDelete: SetNull)
  components         MatchScoreComponent[]
  auditTrail         MatchScoreAuditTrail[]

  // Indices for common queries
  @@unique([playerId, courseId, buildId, tournamentId])
  @@index([playerId, courseId])
  @@index([buildId])
  @@index([tournamentId])
  @@index([version])
  @@index([createdAt])
  @@map("match_scores")
}

/// Immutable record of each score component, for explainability.
/// Created with score, never updated, never deleted.
/// Reference: docs/MATCHING_ENGINE_COMPLETE_ARCHITECTURE.md (Step 6: Explainability)
model MatchScoreComponent {
  id                 String   @id @default(cuid())
  /// Parent score (immutable)
  scoreId            String
  /// Component name (immutable): skillFit, formBonus, venueHistory, confidence, volatility
  componentName      String
  /// Value of this component (immutable)
  componentValue     Float
  /// Reasoning for this component's value (immutable, immutable snapshot)
  componentReasoning String?
  /// Exact attributes/signals used (immutable snapshot for explainability)
  dataUsed           Json?
  /// Created timestamp (immutable)
  createdAt          DateTime @default(now())

  // Relations
  matchScore MatchScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@index([scoreId])
  @@index([componentName])
  @@map("match_score_components")
}

/// Immutable audit trail: append-only log of every prediction access and decision.
/// Provides complete provenance for reproducibility and compliance.
/// Reference: docs/AUDIT_TRAIL_SPECIFICATION.md
model MatchScoreAuditTrail {
  id        String           @id @default(cuid())
  /// Which match score this audit entry refers to (immutable)
  scoreId   String
  /// Action taken (immutable)
  action    MatchScoreAction
  /// User or system that triggered action (immutable)
  actor     String?
  /// Surrounding context (tournament, event type, etc.) (immutable)
  context   Json?
  /// Timestamp (immutable)
  createdAt DateTime         @default(now())

  // Relations
  matchScore MatchScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@index([scoreId])
  @@index([action])
  @@index([createdAt])
  @@map("match_score_audit_trails")
}

// ---------------------------------------------------------------------------
// Historical Data Models (Phase 17.3A)
// ---------------------------------------------------------------------------

/// Canonical entity identifier mapping across providers
model ProviderIdMapping {
  id                    String        @id @default(cuid())
  entityType            EntityType    @default(PLAYER)
  internalId            String
  providerId            String
  provider              String
  providerRecordId      String
  mappingStatus         MappingStatus @default(PENDING)
  verificationSource    String?
  verificationTimestamp DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([provider, providerId, entityType])
  @@index([internalId])
  @@index([mappingStatus])
  @@map("provider_id_mappings")
}

/// Bitemporal historical player features for temporal query support
model HistoricalPlayerFeature {
  id             String  @id @default(cuid())
  playerId       String
  featureKey     String
  featureVersion String
  featureValue   String?
  unit           String?

  // Bitemporal timestamps
  validFrom        DateTime
  validTo          DateTime?
  systemRecordedAt DateTime

  // Provenance
  sourceProvider     String
  sourceRecordId     String?
  retrievalTimestamp DateTime
  rawPayloadChecksum String?

  // Quality
  dataQualityStatus DataQualityStatus @default(VERIFIED)
  missingDataReason String?

  // Transformation
  transformationVersion String?

  // Immutability
  sealed   Boolean   @default(false)
  sealedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([featureKey])
  @@index([validFrom, validTo])
  @@index([playerId, featureKey], name: "idx_historical_player_features_validity") // WHERE validTo IS NULL
  @@map("historical_player_features")
}

/// Immutable prediction input snapshots for historical validation
model HistoricalSnapshot {
  id                   String   @id @default(cuid())
  snapshotHash         String   @unique
  tournamentId         String
  playerId             String
  lockTimestamp        DateTime
  modelVersion         String
  featureSetVersion    String
  features             Json
  featuresIncluded     Json
  featuresExcluded     Json
  lateArrivalsExcluded Json?
  completenessScore    Float?

  // Immutability
  sealed   Boolean   @default(false)
  sealedAt DateTime?

  // Audit
  generatedAt DateTime @default(now())
  generatedBy String   @default("snapshot_service")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId, modelVersion, featureSetVersion])
  @@index([playerId])
  @@index([tournamentId])
  @@index([sealed])
  @@map("historical_snapshots")
}

/// Append-only audit log for data changes
model HistoricalDataAuditEvent {
  id            String         @id @default(cuid())
  eventType     AuditEventType
  entityType    String
  entityId      String
  previousValue String?
  newValue      String?
  reason        String?
  performedBy   String         @default("system")
  performedAt   DateTime
  createdAt     DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([performedAt])
  @@index([eventType])
  @@map("historical_data_audit_events")
}

/// Data quality assessment report
model DataQualityReport {
  id                 String              @id @default(cuid())
  importJobId        String
  generatedAt        DateTime            @default(now())
  totalChecksRun     Int
  checksPassedCount  Int
  checksFailedCount  Int
  details            Json
  qualityStatus      QualityReportStatus
  blockingIssues     Json?
  warningIssues      Json?
  recommendedActions Json?
  createdAt          DateTime            @default(now())

  // Relations
  importJobs HistoricalImportJob[]

  @@index([importJobId])
  @@index([qualityStatus])
  @@map("data_quality_reports")
}

/// Time-versioned player rankings
model HistoricalPlayerRanking {
  id                       String        @id @default(cuid())
  playerId                 String
  rankingSystem            RankingSystem
  playerRank               Int
  rankingPoints            Int?
  publishedDate            DateTime
  effectiveDate            DateTime
  validFrom                DateTime
  validTo                  DateTime?
  source                   String
  retrievedTimestamp       DateTime
  originalRecordIdentifier String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  // Relations
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([validFrom, validTo])
  @@index([rankingSystem])
  @@map("historical_player_rankings")
}

/// Historical salary and odds snapshots
model HistoricalSalaryOddsSnapshot {
  id                     String    @id @default(cuid())
  tournamentId           String
  playerId               String
  dkSalary               Int?
  dkRetrievedAt          DateTime?
  fdSalary               Int?
  fdRetrievedAt          DateTime?
  openingOdds            Float?
  closingOdds            Float?
  oddsMarketTimestamp    DateTime?
  provider               String
  contestSlateIdentifier String?
  createdAt              DateTime  @default(now())

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId, provider])
  @@map("historical_salary_odds_snapshots")
}

/// Tournament outcomes (separate from inputs to prevent look-ahead bias)
model HistoricalTournamentOutcome {
  id                    String            @id @default(cuid())
  tournamentId          String
  playerId              String
  finishPosition        Int?
  officialFinishText    String?
  tieStatus             String?
  cutStatus             CutStatus?
  withdrawalStatus      WithdrawalStatus?
  disqualified          Boolean           @default(false)
  roundScores           Json?
  totalStrokes          Int?
  scoreToPar            Int?
  dkFantasyPoints       Float?
  fdFantasyPoints       Float?
  resultSource          String
  resultSourceTimestamp DateTime?
  retrievedTimestamp    DateTime
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
  @@index([finishPosition])
  @@map("historical_tournament_outcomes")
}

/// Historical import job tracking and status
model HistoricalImportJob {
  id                 String          @id @default(cuid())
  importType         ImportJobType
  sourceProvider     String
  sourceEndpoint     String?
  sourceFileChecksum String?
  startedAt          DateTime
  completedAt        DateTime?
  status             ImportJobStatus @default(PENDING)
  recordsAttempted   Int?
  recordsSucceeded   Int?
  recordsFailed      Int?
  qualityReportId    String?
  errorLog           String?
  createdAt          DateTime        @default(now())

  // Relations
  qualityReport DataQualityReport? @relation(fields: [qualityReportId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([startedAt])
  @@map("historical_import_jobs")
}

/// Provider Registry - single source of truth for all data providers
model HistoricalProvider {
  id                    String                @id @default(cuid())
  providerId            String                @unique
  name                  String
  version               String
  priority              Int                   @default(0)
  supportedDatasets     DatasetType[]
  historicalDepthDays   Int?
  coverage              Float?                // 0-100 percentage
  licensingStatus       String                // INCLUDED, TRIAL, EVALUATION, PENDING
  healthStatus          ProviderHealthStatus  @default(HEALTHY)
  lastSuccessfulSync    DateTime?
  rateLimitPerSecond    Int?
  rateLimitPerDay       Int?
  configuration         Json?                 // provider-specific config
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Relations
  importJobs HistoricalProviderImportJob[]

  @@map("historical_providers")
}

/// Provider-specific import job details
model HistoricalProviderImportJob {
  id                String   @id @default(cuid())
  providerId        String
  jobId             String
  datasetType       DatasetType
  recordsRead       Int?
  recordsInserted   Int?
  recordsUpdated    Int?
  recordsRejected   Int?
  validationErrors  Int?
  duration          Int?     // milliseconds
  sourceChecksum    String?
  startedAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime @default(now())

  // Relations
  provider HistoricalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([datasetType])
  @@map("historical_provider_import_jobs")
}

/// Feature Registry - all engineered features must be registered
model HistoricalFeature {
  id                  String          @id @default(cuid())
  featureName         String          @unique
  description         String?
  category            FeatureCategory
  owner               String?
  provider            String?
  formula             String?         // mathematical or algorithmic formula
  version             String          @default("1.0")
  dependencies        String[]        // list of dependent features
  validationRules     Json?           // validation rule definitions
  usedBy              String[]        // systems/models that use this feature
  deprecated          Boolean         @default(false)
  deprecatedAt        DateTime?
  explainable         Boolean         @default(true)
  exportToClient      Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Relations
  samples HistoricalFeatureSample[]

  @@index([category])
  @@index([deprecated])
  @@map("historical_features")
}

/// Sample feature values (for validation and testing)
model HistoricalFeatureSample {
  id          String   @id @default(cuid())
  featureId   String
  playerId    String
  tournamentId String
  value       String
  unitOfMeasure String?
  validFrom   DateTime
  validTo     DateTime?
  source      String?
  checksum    String?
  createdAt   DateTime @default(now())

  // Relations
  feature HistoricalFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([featureId, playerId, tournamentId])
  @@index([featureId])
  @@index([validFrom, validTo])
  @@map("historical_feature_samples")
}

/// Dataset Health Metrics (calculated view)
model DatasetHealthSnapshot {
  id              String    @id @default(cuid())
  datasetType     DatasetType
  provider        String
  coveragePercent Float
  lastUpdateTime  DateTime?
  staleDays       Int?
  missingPlayers  Int?
  missingTournaments Int?
  duplicateCount  Int?
  validationFailures Int?
  createdAt       DateTime  @default(now())

  @@unique([datasetType, provider])
  @@map("dataset_health_snapshots")
}

