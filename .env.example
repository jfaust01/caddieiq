# ---------------------------------------------------------------------------
# CaddieIQ environment variables
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the Prisma Client at runtime.
# On Neon this should be the POOLED connection string.
DATABASE_URL=

# Optional: direct (unpooled) connection string.
# Used by the Prisma CLI for migrations (`prisma migrate`, `prisma db push`).
# On Neon this is the connection string WITHOUT the `-pooler` host suffix.
# If omitted, the CLI falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
